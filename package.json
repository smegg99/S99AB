{
  "name": "@smegg99/s99ab",
  "version": "1.8.1",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "Shared Nuxt layer: dialogs, toasts, tables, motion, shortcuts, async states.",
  "main": "./web/nuxt.config.ts",
  "files": [
    "web",
    "contracts",
    "!web/tests",
    "!web/vitest.config.ts",
    "!web/node_modules",
    "!web/.nuxt",
    "!web/.output"
  ],
  "exports": {
    ".": "./web/nuxt.config.ts",
    "./styles": "./web/src/styles/index.scss",
    "./tabs": "./web/src/tabs.ts",
    "./types": "./web/src/types.ts",
    "./theme": "./web/src/theme/index.ts",
    "./appearance": "./web/src/appearance.ts",
    "./i18n": "./web/i18n/index.ts",
    "./kratos": "./web/src/kratos.ts",
    "./browser": "./web/src/browser.ts",
    "./state": "./web/src/state.ts",
    "./markdown": "./web/src/markdown.ts",
    "./releases": "./web/src/releases.ts",
    "./explorer": "./web/src/explorer.ts",
    "./toast": "./web/src/toast.ts"
  },
  "peerDependencies": {
    "@firecms/neat": "^0.8.0 || ^1.0.0",
    "@mdi/font": "^7.4.47",
    "@pinia/colada": "^1.3.0",
    "nuxt": "^4.6.4",
    "pinia": "^3.0.0 || ^4.0.0",
    "sass-embedded": "^1.100.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.0.0",
    "vuetify": "^4.0.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@pinia/colada": "^1.4.9",
    "@playwright/test": "1.65.0",
    "@redocly/cli": "2.77.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14",
    "vuetify": "^4.3.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p web/tsconfig.json",
    "test": "cd web && vitest run",
    "test:watch": "cd web && vitest",
    "lint": "eslint .",
    "locales": "go run github.com/smegg99/s99locale/cmd/loc@v1.1.0 build -c web/i18n/config.cue"
  },
  "peerDependenciesMeta": {
    "@firecms/neat": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
